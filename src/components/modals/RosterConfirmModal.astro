---
// Modal Dinâmico de Decisão de Data / Horário / Conflito (Escala)
// Deve ficar fora de qualquer contêiner com transform para que position:fixed funcione corretamente
---
<!-- Modal Dinâmico de Decisão de Data / Horário / Conflito -->
<div id="roster-confirm-modal" class="fixed inset-0 z-[100] bg-inverse-surface/70 backdrop-blur-sm flex items-center justify-center p-4 transition-opacity duration-200 hidden">
  <div class="w-full max-w-lg bg-surface-container-lowest rounded-2xl sm:rounded-3xl p-6 shadow-2xl max-h-[90vh] overflow-y-auto space-y-4 animate-fade-in border border-outline-variant/30 my-auto">
    <!-- Modal Header -->
    <div class="flex items-center gap-3 pb-3 border-b border-outline-variant/20">
      <div id="roster-confirm-icon-box" class="w-10 h-10 rounded-2xl bg-primary/15 text-primary flex items-center justify-center shrink-0">
        <span id="roster-confirm-icon" class="material-symbols-outlined text-[24px]">event_repeat</span>
      </div>
      <div class="min-w-0 flex-1">
        <span id="roster-confirm-badge" class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-primary/10 text-primary mb-0.5">
          Aviso
        </span>
        <h3 id="roster-confirm-title" class="text-base sm:text-lg font-bold text-on-surface truncate">Título do Diálogo</h3>
      </div>
      <button class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer" id="btn-close-roster-confirm-modal" type="button" aria-label="Fechar janela">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>

    <!-- Modal Body -->
    <div class="space-y-3">
      <p id="roster-confirm-message" class="text-sm font-medium text-on-surface leading-relaxed">
        Texto informativo da ação.
      </p>

      <!-- Detalhes do Evento Conflitante / Existente -->
      <div id="roster-confirm-details-box" class="p-3.5 rounded-2xl bg-surface-container-low border border-outline-variant/20 space-y-2 hidden">
        <div class="flex items-center gap-2 text-xs font-semibold text-on-surface-variant">
          <span class="material-symbols-outlined text-[16px] text-primary">church</span>
          <span id="roster-confirm-detail-celebration" class="text-on-surface font-bold">Santa Missa</span>
        </div>
        <div class="flex items-center gap-4 text-xs text-on-surface-variant flex-wrap">
          <span class="flex items-center gap-1">
            <span class="material-symbols-outlined text-[15px]">schedule</span>
            <span id="roster-confirm-detail-time">18:00h</span>
          </span>
          <span class="flex items-center gap-1">
            <span class="material-symbols-outlined text-[15px]">group</span>
            <span id="roster-confirm-detail-ministers">4 ministros</span>
          </span>
          <span class="flex items-center gap-1">
            <span class="material-symbols-outlined text-[15px]">person</span>
            <span id="roster-confirm-detail-celebrant">Pe. Anderson</span>
          </span>
        </div>
      </div>

      <p id="roster-confirm-submessage" class="text-xs text-on-surface-variant font-medium">
        O que você deseja fazer?
      </p>
    </div>

    <!-- Modal Action Buttons (Dinâmicos) -->
    <div id="roster-confirm-actions" class="pt-2 flex flex-col sm:flex-row gap-2">
      <!-- Populado dinamicamente via js/components/roster.js -->
    </div>
  </div>
</div>
