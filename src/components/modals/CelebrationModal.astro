---
// Modal: Cadastrar e Editar Celebração Litúrgica
---
<div class="fixed inset-0 z-50 bg-inverse-surface/60 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4 transition-opacity duration-200 hidden" id="celebration-modal">
  <div class="w-full sm:max-w-lg bg-surface-container-lowest rounded-t-2xl sm:rounded-2xl p-spacing-lg shadow-2xl max-h-[90vh] overflow-y-auto space-y-spacing-md">
    <!-- Modal Header -->
    <div class="flex items-center justify-between pb-2 border-b border-surface-container-high">
      <div>
        <h3 class="font-headline-sm text-headline-sm text-on-surface" id="celebration-modal-title">Cadastrar Nova Celebração</h3>
        <p class="font-body-sm text-body-sm text-on-surface-variant">Preencha as informações litúrgicas da celebração</p>
      </div>
      <button class="w-9 h-9 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface-variant hover:text-on-surface transition-colors" id="close-celebration-modal-btn" type="button" aria-label="Fechar janela">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <!-- Modal Form -->
    <form class="space-y-spacing-md" id="celebration-form">
      <!-- Nome da Celebração -->
      <div class="space-y-1">
        <label class="font-label-sm text-label-sm text-on-surface uppercase tracking-wider font-semibold" for="input-cel-name">Nome da Celebração</label>
        <div class="relative">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 material-symbols-outlined text-on-surface-variant text-[20px]">church</span>
          <input class="w-full h-12 pl-10 pr-3.5 bg-surface-container-low rounded-xl font-body-md text-body-md text-on-surface focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-sm" id="input-cel-name" placeholder="Ex: Missa de Bodas de Prata" required="" type="text"/>
        </div>
      </div>

      <!-- Categoria Litúrgica -->
      <div class="space-y-1">
        <label class="font-label-sm text-label-sm text-on-surface uppercase tracking-wider font-semibold" for="input-cel-category">Categoria Litúrgica</label>
        <div class="relative">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 material-symbols-outlined text-on-surface-variant text-[20px]">category</span>
          <select class="w-full h-12 pl-10 pr-10 bg-surface-container-low rounded-xl font-body-md text-body-md text-on-surface focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-sm appearance-none" id="input-cel-category">
            <option value="dominical" selected="">Dominical (Preceito)</option>
            <option value="semanal">Semanal (Ferial)</option>
            <option value="solenidade">Solenidade Especial</option>
            <option value="sacramento">Sacramento (Batismo, Matrimônio, Crisma)</option>
            <option value="especial">Especial / Devocional / Exéquias</option>
          </select>
          <span class="absolute right-3.5 top-1/2 -translate-y-1/2 material-symbols-outlined text-on-surface-variant text-[20px] pointer-events-none">expand_more</span>
        </div>
      </div>

      <!-- Número Recomendado de Ministros -->
      <div class="space-y-1">
        <label class="font-label-sm text-label-sm text-on-surface uppercase tracking-wider font-semibold" for="input-cel-ministers">Mínimo Sugerido de Ministros</label>
        <div class="relative">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 material-symbols-outlined text-on-surface-variant text-[20px]">groups</span>
          <select class="w-full h-12 pl-10 pr-10 bg-surface-container-low rounded-xl font-body-md text-body-md text-on-surface focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-sm appearance-none" id="input-cel-ministers">
            <option value="2">2 Ministros (Semanal / Capelas)</option>
            <option value="3">3 Ministros (Vespertina / Intermediária)</option>
            <option value="4" selected="">4 Ministros (Dominical Padrão)</option>
            <option value="5">5 Ministros (Missa Solene)</option>
            <option value="6">6 Ministros (Grande Solenidade / Festividade)</option>
          </select>
          <span class="absolute right-3.5 top-1/2 -translate-y-1/2 material-symbols-outlined text-on-surface-variant text-[20px] pointer-events-none">expand_more</span>
        </div>
      </div>

      <!-- Descrição / Observações Litúrgicas -->
      <div class="space-y-1">
        <label class="font-label-sm text-label-sm text-on-surface uppercase tracking-wider font-semibold" for="input-cel-description">Orientações e Observações</label>
        <div class="relative">
          <textarea class="w-full h-24 p-3 bg-surface-container-low rounded-xl font-body-md text-body-md text-on-surface focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-sm resize-none" id="input-cel-description" placeholder="Ex: Bênção especial no início, cálice duplo e acolhida na porta principal."></textarea>
        </div>
      </div>

      <!-- Modal Action Buttons -->
      <div class="pt-spacing-sm flex items-center gap-spacing-xs">
        <button class="flex-1 h-12 rounded-xl bg-surface-container-high text-on-surface font-label-lg text-label-lg hover:bg-surface-variant transition-colors" id="btn-cancel-celebration-modal" type="button">
          Cancelar
        </button>
        <button class="flex-1 h-12 rounded-xl bg-primary text-on-primary font-label-lg text-label-lg shadow-md hover:bg-primary-container transition-colors flex items-center justify-center gap-1.5" type="submit">
          <span class="material-symbols-outlined text-[20px]">save</span>
          Salvar Celebração
        </button>
      </div>
    </form>
  </div>
</div>
