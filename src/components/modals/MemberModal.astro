---
// Modal / Drawer: Cadastrar e Editar Ministro
---
<div class="fixed inset-0 z-50 bg-inverse-surface/60 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4 transition-opacity duration-200 hidden" id="minister-modal">
  <div class="w-full sm:max-w-lg bg-surface-container-lowest rounded-t-2xl sm:rounded-2xl p-spacing-lg shadow-xl max-h-[90vh] overflow-y-auto space-y-spacing-md">
    <!-- Modal Header -->
    <div class="flex items-center justify-between pb-1 border-b border-surface-container-high">
      <div class="flex items-center gap-2.5">
        <div class="w-10 h-10 rounded-full bg-primary-fixed text-primary flex items-center justify-center">
          <span class="material-symbols-outlined text-[22px]">assignment_ind</span>
        </div>
        <div>
          <h3 class="font-headline-sm text-headline-sm text-on-surface leading-tight" id="modal-title">Cadastrar Novo Membro</h3>
          <p class="font-body-sm text-body-sm text-on-surface-variant">Pastoral da Sagrada Comunhão</p>
        </div>
      </div>
      <button class="w-9 h-9 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface-variant hover:text-on-surface transition-colors" id="close-modal-btn" type="button" aria-label="Fechar janela">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <!-- Form Body -->
    <form class="space-y-spacing-sm" id="minister-form">
      <input type="hidden" id="input-status-hidden" value="ativo">

      <!-- Nome Completo -->
      <div class="space-y-1">
        <label class="font-label-sm text-label-sm text-on-surface uppercase tracking-wider font-semibold" for="input-name">Nome Completo</label>
        <div class="relative">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 material-symbols-outlined text-on-surface-variant text-[20px]">person</span>
          <input class="w-full h-12 pl-10 pr-3.5 bg-surface-container-low rounded-xl font-body-md text-body-md text-on-surface focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-sm" id="input-name" placeholder="Ex: João Carlos da Silva" required="" type="text" value="Sebastião Pinheiro Rocha"/>
        </div>
      </div>

      <!-- WhatsApp / Telefone -->
      <div class="space-y-1">
        <label class="font-label-sm text-label-sm text-on-surface uppercase tracking-wider font-semibold" for="input-phone">Telefone / WhatsApp</label>
        <div class="relative">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 material-symbols-outlined text-on-surface-variant text-[20px]">call</span>
          <input class="w-full h-12 pl-10 pr-3.5 bg-surface-container-low rounded-xl font-body-md text-body-md text-on-surface focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-sm" id="input-phone" placeholder="(00) 00000-0000" required="" type="tel" value="(11) 98721-4409"/>
        </div>
      </div>


      <!-- Perfil / Função -->
      <div class="space-y-1">
        <label class="font-label-sm text-label-sm text-on-surface uppercase tracking-wider font-semibold" for="input-profile">Perfil / Função</label>
        <div class="relative">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 material-symbols-outlined text-on-surface-variant text-[20px]">badge</span>
          <select class="w-full h-12 pl-10 pr-10 bg-surface-container-low rounded-xl font-body-md text-body-md text-on-surface focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-sm appearance-none border border-outline-variant/20" id="input-profile">
            <option value="minister" selected>Ministro (MESC)</option>
            <option value="celebrant">Celebrante / Sacerdote</option>
            <option value="deacon">Diácono</option>
            <option value="coordinator">Coordenador(a)</option>
          </select>
          <span class="absolute right-3.5 top-1/2 -translate-y-1/2 material-symbols-outlined text-on-surface-variant text-[20px] pointer-events-none">expand_more</span>
        </div>
      </div>

      <!-- Data de Início no Ministério (Opcional) -->
      <div class="space-y-1">
        <label class="font-label-sm text-label-sm text-on-surface uppercase tracking-wider font-semibold" for="input-start-date">
          Data de Início no Ministério <span class="text-on-surface-variant font-normal lowercase text-[11px]">(opcional)</span>
        </label>
        <div class="relative">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 material-symbols-outlined text-on-surface-variant text-[20px]">calendar_month</span>
          <input class="w-full h-12 pl-10 pr-3.5 bg-surface-container-low rounded-xl font-body-md text-body-md text-on-surface focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-sm cursor-pointer" id="input-start-date" type="date"/>
        </div>
      </div>

      <!-- Status Ministerial (Apenas Ativo e Licença) -->
      <div class="space-y-1">
        <label class="font-label-sm text-label-sm text-on-surface uppercase tracking-wider font-semibold">Situação</label>
        <div class="flex items-center gap-2" id="modal-status-buttons">
          <button class="flex-1 py-2.5 px-3 rounded-xl bg-tertiary-fixed text-on-tertiary-fixed font-label-md text-label-md text-center font-bold shadow-sm" data-status="ativo" type="button">Ativo</button>
          <button class="flex-1 py-2.5 px-3 rounded-xl bg-surface-container-high text-on-surface-variant font-label-md text-label-md text-center transition-colors" data-status="licenca" type="button">Licença</button>
        </div>
      </div>

      <!-- Modal Action Buttons -->
      <div class="pt-spacing-sm flex items-center gap-spacing-xs">
        <button class="flex-1 h-12 rounded-xl bg-surface-container-high text-on-surface font-label-lg text-label-lg hover:bg-surface-variant transition-colors" id="btn-cancel-modal" type="button">
          Cancelar
        </button>
        <button class="flex-1 h-12 rounded-xl bg-primary text-on-primary font-label-lg text-label-lg shadow-md hover:bg-primary-container transition-colors flex items-center justify-center gap-1.5" type="submit">
          <span class="material-symbols-outlined text-[20px]">save</span>
          Salvar
        </button>
      </div>
    </form>
  </div>
</div>
