---
// Tela 3: Gestão de Ministros MESC
---
<div id="view-membros-mesc" class="view-container w-full pt-32 md:pt-24 pb-12 px-margin-screen">
  <div class="flex flex-col w-full space-y-spacing-md max-w-4xl mx-auto">
    <!-- Header Minimalista e Moderno de Ministros -->
    <div class="bg-surface-container-lowest rounded-2xl p-4 sm:p-5 border border-outline-variant/30 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3.5">
      <!-- Título & Subtítulo -->
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-10 h-10 rounded-xl bg-primary-fixed/60 flex items-center justify-center text-primary flex-shrink-0">
          <span class="material-symbols-outlined text-[22px]">groups</span>
        </div>
        <div class="min-w-0">
          <h2 id="stat-total-hero" class="text-base sm:text-lg font-bold text-on-surface tracking-tight leading-tight">Quadro de Ministros</h2>
          <p id="stat-active-hero" class="text-xs text-on-surface-variant font-medium mt-0.5">Carregando ministros...</p>
        </div>
      </div>

      <!-- Métricas Minimalistas (Pills) -->
      <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0 self-start sm:self-auto">
        <!-- Ativos -->
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-surface-container-low/70 border border-outline-variant/25">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <div class="flex items-baseline gap-1.5">
            <span id="stat-active-count" class="text-sm sm:text-base font-bold text-on-surface leading-none">--</span>
            <span class="text-[11px] text-on-surface-variant font-medium">Ativos</span>
          </div>
        </div>

        <!-- Em Licença -->
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-surface-container-low/70 border border-outline-variant/25">
          <span class="w-2 h-2 rounded-full bg-outline/50"></span>
          <div class="flex items-baseline gap-1.5">
            <span id="stat-leave-count" class="text-sm sm:text-base font-bold text-on-surface-variant leading-none">--</span>
            <span class="text-[11px] text-on-surface-variant font-medium">Licença</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Action: Add Minister CTA -->
    <button class="w-full h-12 bg-primary hover:bg-primary-container text-on-primary rounded-xl font-label-lg text-label-lg flex items-center justify-center gap-2 shadow-md active:scale-[0.99] transition-transform" id="open-modal-btn" type="button">
      <span class="material-symbols-outlined text-[20px]">person_add</span>
      Adicionar Novo Ministro
    </button>

    <!-- Search & Filter Bar -->
    <div class="space-y-spacing-xs">
      <div class="relative w-full">
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 material-symbols-outlined text-on-surface-variant text-[20px]">search</span>
        <input class="w-full h-12 pl-10 pr-10 bg-surface-container-lowest rounded-xl font-body-md text-body-md text-on-surface placeholder:text-on-surface-variant/60 shadow-sm focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" id="search-ministers" placeholder="Buscar por nome ou telefone..." type="text"/>
        <button class="absolute right-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface" type="button" onclick="document.getElementById('search-ministers').focus()">
          <span class="material-symbols-outlined text-[20px]">tune</span>
        </button>
      </div>
      <!-- Filter Chips (Sem Formação) -->
      <div id="members-filter-chips" class="flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar">
        <button class="px-3.5 py-1.5 rounded-full bg-primary text-on-primary font-label-sm text-label-sm whitespace-nowrap shadow-sm" data-filter="todos" type="button">
          Todos
        </button>
        <button class="px-3.5 py-1.5 rounded-full bg-surface-container-high text-on-surface-variant hover:text-on-surface font-label-sm text-label-sm whitespace-nowrap" data-filter="ativo" type="button">
          Ativos
        </button>
        <button class="px-3.5 py-1.5 rounded-full bg-surface-container-high text-on-surface-variant hover:text-on-surface font-label-sm text-label-sm whitespace-nowrap" data-filter="licenca" type="button">
          Licença
        </button>
      </div>
    </div>

    <!-- Ministers Roster List (Dinâmica) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3" id="members-list-container">
      <!-- Renderizado via js/components/members.js -->
    </div>

    <!-- Liturgical Warm Message Card -->
    <div class="bg-primary-fixed/40 rounded-xl p-spacing-md flex items-center gap-spacing-sm">
      <div class="w-10 h-10 rounded-full bg-primary text-on-primary flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-[20px]">local_florist</span>
      </div>
      <div class="min-w-0">
        <p class="font-headline-sm text-headline-sm text-primary leading-snug">"Servir com amor e prontidão"</p>
        <p class="font-body-sm text-body-sm text-on-surface-variant">Lembre-se de enviar a confirmação das escalas mensais aos ministros via WhatsApp.</p>
      </div>
    </div>
  </div>
</div>
