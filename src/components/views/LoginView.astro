---
// Tela 1: Acesso e Login SPA
---
<div id="view-inicio-login" class="view-container active w-full min-h-screen">
  <div class="flex flex-col items-center justify-center min-h-screen w-full bg-surface px-margin-screen py-spacing-xl">
    <div class="flex flex-col w-full">
      <div class="flex flex-col items-center w-full max-w-xs mx-auto text-center">
        <div class="w-24 h-24 rounded-full bg-surface-container-lowest shadow-sm flex items-center justify-center p-spacing-xs mb-spacing-md">
          <img alt="Logo Paróquia MESC" class="w-20 h-20 object-contain rounded-full" src="https://lh3.googleusercontent.com/aida/AEtjO1WczmdbAexmyw3qOojOnzA5AVxVZCNbXriGye7jS_Cwc8Aawxmy0VUCvJbfdcx9XuuqJOVJsBwezM_9d8hfUL83kGljIhpDZR8mWVgWoe1gO8yKsNl8x2RBJFVod8YZ67NNKYbw7wi1P8gTG12MiPM-1whPFJWNR-q0QoGjO06EsBEM-eCyIxgmcLllZwwYDYqSa_IBljUsnfJ1g8imbS5GCS1sB36GOJsW87z-cQSn5BYbq5DqpDfS2n_p">
        </div>
        <h1 class="font-headline-lg-mobile text-headline-lg-mobile text-primary tracking-tight mb-spacing-xl">Capela Divino Espírito Santo</h1>

        <form id="login-form" class="flex flex-col gap-spacing-md w-full text-left">
          <div class="flex flex-col gap-1.5">
            <label class="font-label-md text-label-md text-on-surface flex items-center gap-1" for="login-user">
              <span class="material-symbols-outlined text-[16px] text-on-surface-variant">person</span>
              Nome de Usuário
            </label>
            <div class="relative flex items-center">
              <input class="w-full h-12 bg-surface-container-low text-on-surface placeholder:text-outline font-body-md text-body-md px-spacing-md rounded-xl focus:outline-none focus:ring-2 focus:ring-primary/20 focus:bg-surface-container transition-colors" id="login-user" placeholder="Digite seu e-mail ou usuário" type="text" value="admin.pastoral">
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label class="font-label-md text-label-md text-on-surface flex items-center gap-1" for="login-password">
              <span class="material-symbols-outlined text-[16px] text-on-surface-variant">lock</span>
              Senha
            </label>
            <div class="relative flex items-center">
              <input class="w-full h-12 bg-surface-container-low text-on-surface placeholder:text-outline font-body-md text-body-md pl-spacing-md pr-12 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary/20 focus:bg-surface-container transition-colors" id="login-password" placeholder="••••••••••••" type="password" value="pastoral2025">
              <button id="toggle-password-btn" class="absolute right-3 text-on-surface-variant hover:text-on-surface p-1 flex items-center justify-center" type="button" aria-label="Mostrar ou ocultar senha">
                <span class="material-symbols-outlined text-[20px]">visibility</span>
              </button>
            </div>
          </div>

          <button class="mt-spacing-sm w-full h-12 bg-primary-container hover:bg-primary text-on-primary font-label-lg text-label-lg rounded-xl flex items-center justify-center gap-spacing-xs shadow-md transition-all active:scale-[0.99]" type="submit">
            <span class="material-symbols-outlined text-[20px]">login</span>
            <span>Acessar</span>
          </button>

          <button id="btn-visitor-access" class="w-full h-12 bg-surface-container-low hover:bg-surface-container text-primary font-label-lg text-label-lg rounded-xl flex items-center justify-center gap-spacing-xs transition-colors active:scale-[0.99]" type="button">
            <span class="material-symbols-outlined text-[20px]">visibility</span>
            <span>Acessar como visitante</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
