---
// Tela 5: Construtor e Gestão de Escalas Litúrgicas
---
<div id="view-montar-escala" class="view-container w-full pt-32 md:pt-24 pb-12 px-margin-screen">
  <div class="flex flex-col w-full space-y-spacing-md max-w-4xl mx-auto">
    <!-- Banner Informativo de Modo de Edição -->
    <div id="roster-edit-banner" class="hidden bg-secondary-container/30 border border-secondary/30 rounded-2xl p-4 items-center justify-between gap-3 shadow-xs">
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-9 h-9 rounded-xl bg-secondary text-on-secondary flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-[20px]">edit_calendar</span>
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-secondary px-2 py-0.5 rounded-md bg-secondary/15">Modo de Edição</span>
            <span id="roster-edit-event-id" class="text-xs text-on-surface-variant font-medium">#501</span>
          </div>
          <p id="roster-edit-desc" class="text-sm font-semibold text-on-surface truncate mt-0.5">Editando escala existente</p>
        </div>
      </div>
      <button type="button" id="btn-cancel-roster-edit" class="px-3 py-1.5 rounded-xl bg-surface-container-high hover:bg-surface-container-highest text-on-surface text-xs font-semibold flex items-center gap-1 transition-all active:scale-95 shrink-0 cursor-pointer">
        <span class="material-symbols-outlined text-[16px]">add</span>
        <span>Criar Nova</span>
      </button>
    </div>

    <!-- Passo 1 -->
    <div class="bg-surface-container-lowest rounded-2xl p-4 sm:p-5 border border-outline-variant/30 shadow-sm">
      <div class="flex items-center justify-end mb-spacing-xs">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1 text-on-surface-variant font-label-sm text-label-sm bg-surface-container-high px-2 py-0.5 rounded-full" id="roster-month-badge">
            <span class="material-symbols-outlined text-[14px]">event</span>
            Outubro 2025
          </span>
        </div>
      </div>
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div>
          <h2 class="font-headline-sm text-headline-sm text-on-surface">Data e Celebração</h2>
          <p class="font-body-sm text-body-sm text-on-surface-variant">Selecione a data e o horário para montar ou editar a escala.</p>
        </div>
        <!-- Seletores de Data e Horário -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <!-- Seletor Rápido de Data do Calendário Ampliado -->
          <div class="flex items-center justify-between sm:justify-start gap-3 bg-surface-container-low px-4 py-2.5 rounded-2xl border-2 border-surface-container-high hover:border-primary/40 focus-within:border-primary transition-all shadow-sm">
            <label for="roster-date-picker" class="font-label-md text-label-md text-on-surface font-bold flex items-center gap-2 cursor-pointer whitespace-nowrap">
              <span class="material-symbols-outlined text-primary text-[26px]">calendar_month</span>
              <span>Data da Escala:</span>
            </label>
            <input type="date" id="roster-date-picker" value="2025-10-19" class="bg-surface text-on-surface font-title-md text-title-md font-semibold h-11 px-3 py-1.5 rounded-xl border border-outline/20 focus:outline-none focus:ring-2 focus:ring-primary/30 cursor-pointer shadow-inner">
          </div>

          <!-- Seletor Suspenso de Horário da Missa -->
          <div class="flex items-center justify-between sm:justify-start gap-3 bg-surface-container-low px-4 py-2.5 rounded-2xl border-2 border-surface-container-high hover:border-primary/40 focus-within:border-primary transition-all shadow-sm">
            <label for="roster-hour-select" class="font-label-md text-label-md text-on-surface font-bold flex items-center gap-2 cursor-pointer whitespace-nowrap">
              <span class="material-symbols-outlined text-primary text-[26px]">schedule</span>
              <span>Horário da Missa:</span>
            </label>
            <div class="relative min-w-[110px]">
              <select id="roster-hour-select" class="w-full bg-surface text-on-surface font-title-md text-title-md font-semibold h-11 pl-3 pr-8 py-1.5 rounded-xl border border-outline/20 focus:outline-none focus:ring-2 focus:ring-primary/30 cursor-pointer shadow-inner appearance-none">
                <option value="07:00">07:00</option>
                <option value="08:00">08:00</option>
                <option value="10:00" selected>10:00</option>
                <option value="18:00">18:00</option>
                <option value="19:00">19:00</option>
                <option value="19:30">19:30</option>
              </select>
              <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none text-[20px]">expand_more</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Passo 2 -->
    <div class="bg-surface-container-lowest rounded-2xl p-4 sm:p-5 border border-outline-variant/30 shadow-sm">
      <div class="space-y-spacing-sm">
        <!-- Seleção do Nome da Celebração -->
        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="block font-label-md text-label-md text-on-surface font-semibold" for="celebration-select">Nome da Celebração</label>
            <button type="button" id="btn-toggle-new-celebration" class="text-primary hover:text-primary-container font-label-sm text-label-sm flex items-center gap-1 font-semibold">
              <span class="material-symbols-outlined text-[16px]">add_circle</span>
              <span>Cadastrar Novo Nome</span>
            </button>
          </div>

          <!-- Select da Lista Pré-definida -->
          <div class="relative">
            <select class="w-full bg-surface-container-low text-on-surface font-body-md text-body-md rounded-xl p-3 pr-10 appearance-none focus:outline-none focus:ring-2 focus:ring-primary/20 focus:bg-surface-container font-medium border border-outline-variant/20" id="celebration-select">
              <!-- Populado dinamicamente via js/components/roster.js -->
            </select>
            <span class="material-symbols-outlined absolute right-3 top-3 text-on-surface-variant pointer-events-none text-[20px]">expand_more</span>
          </div>
        </div>

        <!-- Subtítulo / Tema Litúrgico Complementar (Opcional) -->
        <div>
          <label class="block font-label-md text-label-md text-on-surface mb-1 font-semibold" for="roster-subtitle">Subtítulo / Tema Litúrgico <span class="text-on-surface-variant font-normal text-[12px]">(opcional)</span></label>
          <input type="text" id="roster-subtitle" placeholder="Ex: Bodas de Prata, 1ª Sexta-feira, Cor Litúrgica..." class="w-full bg-surface-container-low text-on-surface font-body-md text-body-md rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:bg-surface-container font-medium border border-outline-variant/20">
        </div>

        <!-- Seleção do Celebrante Principal -->
        <div>
          <label class="block font-label-md text-label-md text-on-surface mb-1 font-semibold" for="celebrante">Celebrante Principal</label>
          <div class="relative">
            <select class="w-full bg-surface-container-low text-on-surface font-body-md text-body-md rounded-xl p-3 pr-10 appearance-none focus:outline-none focus:ring-2 focus:ring-primary/20 focus:bg-surface-container font-medium border border-outline-variant/20" id="celebrante">
              <!-- Populado dinamicamente via js/components/roster.js a partir dos membros celebrantes -->
            </select>
            <span class="material-symbols-outlined absolute right-3 top-3 text-on-surface-variant pointer-events-none text-[20px]">expand_more</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Passo 3 -->
    <div class="bg-surface-container-lowest rounded-2xl p-4 sm:p-5 border border-outline-variant/30 shadow-sm">
      <div class="flex items-center justify-end mb-spacing-xs">
        <span class="font-label-sm text-label-sm bg-tertiary-fixed text-on-tertiary-fixed px-2.5 py-0.5 rounded-full font-bold" id="slot-counter">0 Ministros Escalados</span>
      </div>
      <h2 class="font-headline-sm text-headline-sm text-on-surface">Ministros Escalados</h2>
      <p class="font-body-sm text-body-sm text-on-surface-variant mb-spacing-md">Ministros escalados para servir nesta celebração.</p>
      
      <!-- Escalados Roster (Dinâmico) -->
      <div class="space-y-spacing-xs mb-spacing-md" id="escalados-list">
        <!-- Renderizado via js/components/roster.js -->
      </div>

      <!-- Add Minister Filter & Search -->
      <div class="bg-surface-container-low/70 rounded-xl p-spacing-sm border border-outline-variant/20">
        <div class="flex items-center justify-between mb-spacing-xs">
          <h3 class="font-title-md text-title-md text-on-surface font-semibold">Adicionar Ministros</h3>
          <span id="active-base-count" class="font-label-sm text-label-sm text-on-surface-variant">Base Ativa (28)</span>
        </div>
        <!-- Search Bar -->
        <div class="relative mb-spacing-xs">
          <span class="material-symbols-outlined absolute left-3 top-2.5 text-on-surface-variant text-[20px]">search</span>
          <input class="w-full bg-surface-container-lowest text-on-surface font-body-sm text-body-sm rounded-lg py-2.5 pl-10 pr-3 focus:outline-none focus:ring-2 focus:ring-primary/20 shadow-sm border border-outline-variant/30" id="minister-search" placeholder="Buscar por nome ou telefone..." type="text"/>
        </div>
        <!-- Candidate Minister List (Dinâmico) -->
        <div class="space-y-spacing-xs max-h-56 overflow-y-auto pr-1" id="candidate-ministers-list">
          <!-- Renderizado via js/components/roster.js -->
        </div>
      </div>
    </div>

    <!-- Action Section -->
    <div class="pt-spacing-xs space-y-spacing-xs">
      <!-- Primary CTA: Save -->
      <button class="w-full h-12 py-3 px-4 rounded-xl bg-primary text-on-primary font-label-lg text-label-lg shadow-sm flex items-center justify-center gap-2 hover:bg-primary-container active:scale-[0.99] transition-all" id="btn-save-roster" type="button">
        <span class="material-symbols-outlined text-[20px]" id="btn-save-roster-icon">check_circle</span>
        <span id="btn-save-roster-text">Salvar Escala</span>
      </button>
      <!-- Secondary CTA: Save and Copy Reminder -->
      <button class="w-full h-12 py-3 px-4 rounded-xl bg-surface-container-high text-primary font-label-lg text-label-lg flex items-center justify-center gap-2 hover:bg-surface-container-highest active:scale-[0.99] transition-all" id="btn-save-notify" type="button">
        <span class="material-symbols-outlined text-primary text-[20px]">content_copy</span>
        <span id="btn-save-notify-text">Salvar e Copiar Lembrete</span>
      </button>
      <!-- Botão de Exclusão da Escala (Apenas visível no Modo de Edição) -->
      <button class="w-full h-11 py-2.5 px-4 rounded-xl bg-error-container/30 text-error hover:bg-error-container/60 font-label-md text-label-md hidden items-center justify-center gap-1.5 transition-colors cursor-pointer" id="btn-delete-roster-scale" type="button">
        <span class="material-symbols-outlined text-[18px]">delete</span>
        <span>Excluir Esta Escala</span>
      </button>
      <!-- Export Monthly PDF Options -->
      <button class="w-full h-11 py-2.5 px-4 rounded-xl text-on-surface-variant font-label-md text-label-md flex items-center justify-center gap-1.5 hover:bg-surface-container-low transition-colors" id="btn-export-pdf" type="button">
        <span class="material-symbols-outlined text-[18px]">picture_as_pdf</span>
        Opções de Impressão e PDF
      </button>
    </div>
  </div>

  <!-- Popup Modal: Cadastrar Novo Nome de Celebração -->
  <div id="roster-celebration-modal" class="fixed inset-0 z-50 bg-inverse-surface/60 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4 transition-opacity duration-200 hidden">
    <div class="w-full sm:max-w-md bg-surface-container-lowest rounded-t-3xl sm:rounded-3xl p-6 shadow-2xl max-h-[90vh] overflow-y-auto space-y-4 animate-fade-in border border-outline-variant/30">
      <!-- Modal Header -->
      <div class="flex items-center justify-between pb-3 border-b border-outline-variant/20">
        <div>
          <h3 class="text-lg font-bold text-on-surface">Cadastrar Celebração</h3>
          <p class="text-xs text-on-surface-variant font-medium">Cadastre e use imediatamente nesta escala</p>
        </div>
        <button class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface-variant hover:text-on-surface transition-colors" id="btn-close-roster-celebration-modal" type="button" aria-label="Fechar janela">
          <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
      </div>

      <!-- Form Fields -->
      <div class="space-y-3.5">
        <div class="space-y-1">
          <label class="block font-label-sm text-label-sm text-on-surface uppercase tracking-wider font-semibold" for="new-celebration-name">Nome da Celebração</label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 material-symbols-outlined text-on-surface-variant text-[20px]">church</span>
            <input type="text" id="new-celebration-name" placeholder="Ex: Missa de Bodas de Prata" class="w-full h-12 pl-10 pr-3.5 bg-surface-container-low rounded-xl font-body-md text-body-md text-on-surface focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-sm border border-outline-variant/20">
          </div>
        </div>

        <!-- Categoria Litúrgica -->
        <div class="space-y-1">
          <label class="block font-label-sm text-label-sm text-on-surface uppercase tracking-wider font-semibold" for="new-celebration-category">Categoria Litúrgica</label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 material-symbols-outlined text-on-surface-variant text-[20px]">category</span>
            <select class="w-full h-12 pl-10 pr-10 bg-surface-container-low rounded-xl font-body-md text-body-md text-on-surface focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-sm appearance-none border border-outline-variant/20" id="new-celebration-category">
              <option value="dominical" selected="">Dominical (Preceito)</option>
              <option value="semanal">Semanal (Ferial)</option>
              <option value="solenidade">Solenidade Especial</option>
              <option value="sacramento">Sacramento (Batismo, Matrimônio, Crisma)</option>
              <option value="especial">Especial / Devocional / Exéquias</option>
            </select>
            <span class="absolute right-3.5 top-1/2 -translate-y-1/2 material-symbols-outlined text-on-surface-variant text-[20px] pointer-events-none">expand_more</span>
          </div>
        </div>
      </div>

      <!-- Modal Actions -->
      <div class="pt-2 flex items-center gap-2">
        <button type="button" id="btn-cancel-new-celebration" class="flex-1 h-11 rounded-xl bg-surface-container-high text-on-surface font-label-md text-label-md hover:bg-surface-variant transition-colors">
          Cancelar
        </button>
        <button type="button" id="btn-save-new-celebration" class="flex-1 h-11 rounded-xl bg-primary text-on-primary font-label-md text-label-md shadow-md hover:bg-primary-container transition-colors flex items-center justify-center gap-1.5 font-semibold">
          <span class="material-symbols-outlined text-[18px]">save</span>
          Salvar Celebração
        </button>
      </div>
    </div>
  </div>
</div>
