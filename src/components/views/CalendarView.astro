---
// Tela 2: Calendário Litúrgico e Escalas
---
<div id="view-calendario-missas" class="view-container w-full pt-32 md:pt-24 pb-12 px-margin-screen">
  <div class="flex flex-col w-full pb-8 max-w-4xl mx-auto">
    <!-- Header Minimalista e Moderno de Calendário -->
    <section class="bg-surface-container-lowest rounded-2xl p-4 sm:p-5 border border-outline-variant/30 shadow-sm mb-spacing-md flex flex-col gap-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3.5">
        <!-- Título & Subtítulo -->
        <div class="flex items-center gap-3 min-w-0">
          <div class="w-10 h-10 rounded-xl bg-primary-fixed/60 flex items-center justify-center text-primary flex-shrink-0">
            <span class="material-symbols-outlined text-[22px]">calendar_today</span>
          </div>
          <div class="min-w-0">
            <h1 class="text-base sm:text-lg font-bold text-on-surface tracking-tight leading-tight">Calendário de Escalas</h1>
            <p class="text-xs text-on-surface-variant font-medium mt-0.5">Selecione uma data para conferir ou montar escalas</p>
          </div>
        </div>

        <!-- Ações Rápidas Minimalistas -->
        <div class="flex items-center gap-2 flex-wrap sm:flex-nowrap flex-shrink-0">
          <button aria-label="Exportar Escala" class="flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-surface-container-low hover:bg-surface-container-high text-on-surface border border-outline-variant/30 font-label-sm text-label-sm shadow-sm active:scale-95 transition-all" id="shareSheetBtn" type="button">
            <span class="material-symbols-outlined text-[18px] text-primary">picture_as_pdf</span>
            <span>Exportar PDF</span>
          </button>
          <button id="btn-calendar-create-roster" aria-label="Montar Nova Escala" class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-primary text-on-primary font-label-sm text-label-sm shadow-sm hover:opacity-95 active:scale-95 transition-all cursor-pointer" type="button">
            <span class="material-symbols-outlined text-[18px]">edit_calendar</span>
            <span>Montar Escala</span>
          </button>
        </div>
      </div>
    </section>

    <!-- Calendário Mensal Principal -->
    <section class="w-full bg-surface-container-lowest rounded-2xl p-4 sm:p-6 border border-outline-variant/30 shadow-sm flex flex-col gap-4">
      <!-- Cabeçalho de Navegação do Mês -->
      <div class="flex items-center justify-between pb-3 border-b border-outline-variant/20">
        <div class="flex items-center gap-2.5">
          <h2 id="calendar-month-name" class="text-xl sm:text-2xl font-bold text-on-surface tracking-tight">Outubro</h2>
          <span id="calendar-year-badge" class="px-2.5 py-0.5 rounded-full bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm font-semibold border border-outline-variant/30">2025</span>
        </div>
        <div class="flex items-center gap-1.5">
          <button id="btn-prev-month" aria-label="Mês anterior" class="w-9 h-9 rounded-xl flex items-center justify-center text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low border border-outline-variant/20 transition-all active:scale-95" type="button">
            <span class="material-symbols-outlined text-[20px]">chevron_left</span>
          </button>
          <button id="btn-next-month" aria-label="Próximo mês" class="w-9 h-9 rounded-xl flex items-center justify-center text-on-surface hover:bg-surface-container-low border border-outline-variant/20 transition-all active:scale-95" type="button">
            <span class="material-symbols-outlined text-[20px]">chevron_right</span>
          </button>
        </div>
      </div>

      <!-- Dias da semana -->
      <div class="grid grid-cols-7 gap-1 sm:gap-2 text-center font-label-sm text-label-sm py-1">
        <span class="text-primary font-bold">DOM</span>
        <span class="text-on-surface-variant/80 font-semibold">SEG</span>
        <span class="text-on-surface-variant/80 font-semibold">TER</span>
        <span class="text-on-surface-variant/80 font-semibold">QUA</span>
        <span class="text-on-surface-variant/80 font-semibold">QUI</span>
        <span class="text-on-surface-variant/80 font-semibold">SEX</span>
        <span class="text-on-surface-variant/80 font-semibold">SÁB</span>
      </div>

      <!-- Grade Dinâmica de Dias -->
      <div class="grid grid-cols-7 gap-1.5 sm:gap-2 text-center" id="calendarGrid">
        <!-- Renderizado dinamicamente via js/components/calendar.js -->
      </div>

      <!-- Legenda Litúrgica Minimalista -->
      <div class="flex items-center justify-center gap-4 sm:gap-6 pt-3 border-t border-outline-variant/20 flex-wrap">
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-primary"></span>
          <span class="text-xs text-on-surface-variant font-medium">Dia com escala</span>
        </div>
      </div>
    </section>

    <!-- Card Interativo Detalhado do Dia Selecionado -->
    <section class="w-full mt-spacing-md flex flex-col gap-spacing-sm" id="selectedRosterSection">
      <div class="bg-surface-container-lowest rounded-2xl p-4 sm:p-6 border border-outline-variant/30 shadow-sm flex flex-col gap-4 relative overflow-hidden">
        <!-- Fita Litúrgica no Topo -->
        <div class="absolute top-0 left-0 right-0 h-1 liturgical-ribbon"></div>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 pt-1">
          <div>
            <h3 class="text-lg sm:text-xl font-bold text-primary tracking-tight" id="selectedDateTitle">Domingo, 12/10/2025</h3>
            <p class="text-xs sm:text-sm text-on-surface-variant font-medium flex items-center gap-1.5 mt-0.5" id="selectedMassSubtitle">
              <span class="material-symbols-outlined text-[16px] text-secondary">schedule</span>
              19:00h - Missa semanal de quarta-feira - Pe. Abcde
            </p>
          </div>
          <div class="flex items-center">
            <span id="selectedSlotRatio" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-primary-fixed/50 text-primary font-label-sm text-label-sm font-bold border border-primary-fixed whitespace-nowrap">
              <span class="material-symbols-outlined text-[15px] leading-none">group</span>
              <span>5 Ministros Escalados</span>
            </span>
          </div>
        </div>

        <div class="h-px bg-outline-variant/20 w-full"></div>

        <!-- Lista Dinâmica de Ministros Escalados (Grid 2 colunas responsiva) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5" id="ministersRosterList">
          <!-- Renderizado via js/components/calendar.js -->
        </div>

        <!-- Botões de Ação Direta no Card -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-3 border-t border-outline-variant/20 no-print">
          <button class="flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface font-label-md text-label-md border border-outline-variant/30 active:scale-95 transition-all shadow-xs" id="copyWhatsappBtn" type="button">
            <span class="material-symbols-outlined text-[18px] text-primary">content_copy</span>
            <span>Copiar Lembrete</span>
          </button>
          <button class="flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface font-label-md text-label-md border border-outline-variant/30 active:scale-95 transition-all shadow-xs" id="printPdfBtn" type="button">
            <span class="material-symbols-outlined text-[18px] text-primary">picture_as_pdf</span>
            <span>Opções de Impressão</span>
          </button>
        </div>
      </div>
    </section>
  </div>
</div>
