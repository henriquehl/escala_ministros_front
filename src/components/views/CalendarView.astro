---
// Tela 2: Calendário Litúrgico e Escalas
---
<div id="view-calendario-missas" class="view-container w-full pt-32 md:pt-24 pb-12 px-margin-screen">
  <div class="flex flex-col w-full pb-8 max-w-4xl mx-auto">
    <!-- Topo da Seção & Exportar -->
    <section class="flex flex-col gap-spacing-xs mb-spacing-md">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-spacing-xs">
          <span class="p-2 rounded-xl bg-primary-fixed text-primary flex items-center justify-center shadow-sm">
            <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">calendar_today</span>
          </span>
          <div>
            <h1 class="font-headline-sm text-headline-sm text-primary leading-tight">Calendário de Escalas</h1>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Selecione uma data litúrgica para conferir as presenças</p>
          </div>
        </div>
        <div class="flex items-center gap-2 flex-wrap sm:flex-nowrap">
          <button aria-label="Exportar Escala" class="flex items-center gap-1.5 px-spacing-sm py-2 rounded-xl bg-secondary-container text-on-secondary-container shadow-sm active:scale-95 transition-transform" id="shareSheetBtn" type="button">
            <span class="material-symbols-outlined text-[18px]">picture_as_pdf</span>
            <span class="font-label-sm text-label-sm">Exportar / Imprimir</span>
          </button>
          <button aria-label="Montar Nova Escala" class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-primary text-on-primary shadow-sm hover:opacity-95 active:scale-95 transition-all text-left" data-path="montar-escala" type="button">
            <span class="material-symbols-outlined text-[18px]">edit_calendar</span>
            <div class="flex flex-col">
              <span class="font-label-sm text-label-sm font-semibold leading-tight">Montar Nova Escala</span>
              <span class="text-[10px] text-on-primary/80 leading-tight">distribuir ministros para o mês</span>
            </div>
          </button>
        </div>
      </div>

      <!-- Filtros Rápidos de Horário das Missas -->
      <div id="calendar-time-filters" class="flex items-center gap-2 overflow-x-auto py-1 no-scrollbar -mx-margin-screen px-margin-screen">
        <button class="filter-chip px-3.5 py-1.5 rounded-full bg-primary text-on-primary font-label-md text-label-md whitespace-nowrap shadow-sm transition-all" data-horario="todos" type="button">
          Todos os Horários
        </button>
        <button class="filter-chip px-3.5 py-1.5 rounded-full bg-surface-container-high text-on-surface font-label-md text-label-md whitespace-nowrap active:scale-95 transition-all" data-horario="08:00" type="button">
          08:00h
        </button>
        <button class="filter-chip px-3.5 py-1.5 rounded-full bg-surface-container-high text-on-surface font-label-md text-label-md whitespace-nowrap active:scale-95 transition-all" data-horario="10:00" type="button">
          10:00h
        </button>
        <button class="filter-chip px-3.5 py-1.5 rounded-full bg-surface-container-high text-on-surface font-label-md text-label-md whitespace-nowrap active:scale-95 transition-all" data-horario="19:00" type="button">
          19:00h
        </button>
      </div>
    </section>

    <!-- Calendário Mensal Principal -->
    <section class="w-full bg-surface-container-lowest rounded-2xl p-spacing-sm shadow-sm flex flex-col gap-spacing-sm">
      <!-- Cabeçalho de Navegação do Mês -->
      <div class="flex items-center justify-between px-1">
        <div class="flex items-center gap-2">
          <h2 id="calendar-month-name" class="font-headline-md text-headline-md text-on-surface">Outubro</h2>
          <span id="calendar-year-badge" class="px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm">2025</span>
        </div>
        <div class="flex items-center gap-1">
          <button id="btn-prev-month" aria-label="Mês anterior" class="w-10 h-10 rounded-full flex items-center justify-center text-on-surface-variant hover:bg-surface-container transition-colors" type="button">
            <span class="material-symbols-outlined text-[22px]">chevron_left</span>
          </button>
          <button id="btn-next-month" aria-label="Próximo mês" class="w-10 h-10 rounded-full flex items-center justify-center text-on-surface hover:bg-surface-container transition-colors" type="button">
            <span class="material-symbols-outlined text-[22px]">chevron_right</span>
          </button>
        </div>
      </div>

      <!-- Dias da semana -->
      <div class="grid grid-cols-7 gap-1 text-center font-label-sm text-label-sm text-on-surface-variant py-1">
        <span>DOM</span>
        <span>SEG</span>
        <span>TER</span>
        <span>QUA</span>
        <span>QUI</span>
        <span>SEX</span>
        <span>SÁB</span>
      </div>

      <!-- Grade Dinâmica de Dias -->
      <div class="grid grid-cols-7 gap-1 text-center font-body-md text-body-md" id="calendarGrid">
        <!-- Renderizado dinamicamente via js/components/calendar.js -->
      </div>

      <!-- Legenda Litúrgica Discreta -->
      <div class="flex items-center justify-center gap-spacing-md pt-2 border-t border-surface-container-high">
        <div class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
          <span class="font-label-sm text-label-sm text-on-surface-variant">Missa &amp; Escala</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-secondary-container"></span>
          <span class="font-label-sm text-label-sm text-on-surface-variant">Solenidade Especial</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-surface-container-highest"></span>
          <span class="font-label-sm text-label-sm text-on-surface-variant">Dia Comum</span>
        </div>
      </div>
    </section>

    <!-- Card Interativo Detalhado do Dia Selecionado -->
    <section class="w-full mt-spacing-md flex flex-col gap-spacing-sm" id="selectedRosterSection">
      <div class="bg-surface-container-lowest rounded-2xl p-spacing-md shadow-sm flex flex-col gap-spacing-sm relative overflow-hidden">
        <!-- Fita Litúrgica Dourada no Topo -->
        <div class="absolute top-0 left-0 right-0 h-1.5 liturgical-ribbon"></div>

        <div class="flex items-start justify-between mt-1">
          <div>
            <h3 class="font-headline-sm text-headline-sm text-primary" id="selectedDateTitle">Domingo, 12/10/2025</h3>
            <p class="font-body-md text-body-md text-on-surface font-medium flex items-center gap-1.5 mt-0.5" id="selectedMassSubtitle">
              <span class="material-symbols-outlined text-[18px] text-secondary">schedule</span>
              19:00h · Solenidade de N. Sra. Aparecida
            </p>
          </div>
          <div class="flex flex-col items-end">
            <span id="selectedSlotRatio" class="px-2.5 py-1 rounded-lg bg-secondary-container text-on-secondary-container font-label-md text-label-md font-bold shadow-xs whitespace-nowrap">Ministros escalados: 5</span>
          </div>
        </div>

        <div class="h-px bg-surface-container-high w-full"></div>

        <!-- Lista Dinâmica de Ministros Escalados -->
        <div class="flex flex-col gap-3" id="ministersRosterList">
          <!-- Renderizado via js/components/calendar.js -->
        </div>

        <!-- Botões de Ação Direta no Card (Com "Copiar lembrete") -->
        <div class="grid grid-cols-2 gap-2 mt-2 pt-2 border-t border-surface-container-high no-print">
          <button class="flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl bg-surface-container text-on-surface font-label-md text-label-md active:scale-95 transition-transform hover:bg-surface-container-high" id="copyWhatsappBtn" type="button">
            <span class="material-symbols-outlined text-[18px] text-primary">content_copy</span>
            <span>Copiar lembrete</span>
          </button>
          <button class="flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl bg-surface-container text-on-surface font-label-md text-label-md active:scale-95 transition-transform hover:bg-surface-container-high" id="printPdfBtn" type="button">
            <span class="material-symbols-outlined text-[18px] text-primary">picture_as_pdf</span>
            <span>Opções de Impressão</span>
          </button>
        </div>
      </div>
    </section>
  </div>
</div>
